# Template systemd unit for the PoliCita chat app.
#
# Install with:
#   sudo cp deploy/policita.service /etc/systemd/system/policita.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now policita
#
# Adjust User, paths, and port to match your droplet before installing.

[Unit]
Description=PoliCita chat (FastAPI via uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=policita
Group=policita

# Both of these matter. WorkingDirectory is what lets load_dotenv() find .env
# at all; EnvironmentFile makes systemd itself read the same file, so the
# process still gets its config even if the working directory ever changes.
WorkingDirectory=/opt/policita
EnvironmentFile=/opt/policita/.env

ExecStart=/opt/policita/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
